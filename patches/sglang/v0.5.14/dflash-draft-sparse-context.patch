+    def _record_draft_sparse_prompts(self, batch) -> None:
+        """Remember, per request, which prompt positions the sparse draft sees."""
+        reqs = getattr(batch, "reqs", None)
+        if reqs is None:
+            raise RuntimeError(
+                "DFLASH draft sparse context needs ScheduleBatch.reqs at prefill"
+            )
+        pool_indices = batch.req_pool_indices.tolist()
+        for req, pool_idx in zip(reqs, pool_indices):
+            pool_idx = int(pool_idx)
+            entry = self._draft_sparse_prompt_masks.get(pool_idx)
+            if entry is not None and entry[0] == req.rid:
+                continue  # a later chunk of the same prompt
+            spans = []
+            mm_inputs = getattr(req, "multimodal_inputs", None)
+            for item in getattr(mm_inputs, "mm_items", None) or []:
+                for start, end in getattr(item, "offsets", None) or []:
+                    spans.append((int(start), int(end)))
+            prompt_len = len(req.origin_input_ids)
+            mask = self.draft_sparse.prompt_keep_mask(prompt_len, spans, self.device)
+            self._draft_sparse_prompt_masks[pool_idx] = (req.rid, mask)
+            if not self._draft_sparse_logged and self.tp_rank == 0:
+                logger.info(
+                    "DFLASH draft sparse context (%s): prompt_len=%d visual_spans=%d "
+                    "visual_tokens=%d kept_prompt_positions=%d",
+                    self.draft_sparse,
+                    prompt_len,
+                    len(spans),
+                    sum(end - start + 1 for start, end in spans),
+                    int(mask.sum().item()),
+                )
+                self._draft_sparse_logged = True
+
+    def _gather_draft_sparse_context(
+        self, batch, prefix_lens: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Kept-position counts (int32) and their cache slots, ascending per request."""
+        cfg = self.draft_sparse
+        pool_indices = batch.req_pool_indices
+        pool_list = pool_indices.tolist()
+        prefix_list = prefix_lens.tolist()
+        keep_positions = []
+        for pool_idx, seq_len in zip(pool_list, prefix_list):
+            seq_len = int(seq_len)
+            entry = self._draft_sparse_prompt_masks.get(int(pool_idx))
+            if entry is None:
+                raise RuntimeError(
+                    "DFLASH draft sparse context has no prompt mask for "
+                    f"req_pool_idx={pool_idx}; prefill did not record it"
+                )
+            prompt_mask = entry[1]
+            keep = torch.zeros(seq_len, dtype=torch.bool, device=self.device)
+            n_prompt = min(seq_len, int(prompt_mask.numel()))
+            keep[:n_prompt] = prompt_mask[:n_prompt]
+            if cfg.text and seq_len > n_prompt:
+                keep[n_prompt:] = True  # generated tokens are text
+            if cfg.window > 0:
+                keep[max(seq_len - cfg.window, 0) :] = True
+            keep_positions.append(keep.nonzero(as_tuple=True)[0])
+        bs = len(keep_positions)
+        lengths = torch.tensor(
+            [int(p.numel()) for p in keep_positions],
+            dtype=torch.int64,
+            device=self.device,
+        )
+        max_len = int(lengths.max().item()) if bs else 0
+        pos2d = torch.zeros((bs, max_len), dtype=torch.int64, device=self.device)
+        mask = torch.zeros((bs, max_len), dtype=torch.bool, device=self.device)
+        for i, positions in enumerate(keep_positions):
+            pos2d[i, : positions.numel()] = positions
+            mask[i, : positions.numel()] = True
+        cache_loc = self._gather_req_to_token_masked(
+            req_to_token=self.model_runner.req_to_token_pool.req_to_token,
+            req_pool_indices=pool_indices,
+            pos2d=pos2d,
+            mask=mask,
+            context="DFLASH draft sparse context gather",
+        )
+        return lengths.to(torch.int32), cache_loc
+
