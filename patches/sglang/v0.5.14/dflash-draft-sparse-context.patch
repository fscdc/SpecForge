 logger = logging.getLogger(__name__)
 
 
+class DFlashDraftSparseContext:
+    """Training-free sparse context for the DFlash draft (SpecForge experiment).
+
+    Off unless ``SGLANG_DFLASH_DRAFT_SPARSE`` is set, for example
+    ``SGLANG_DFLASH_DRAFT_SPARSE="sink=4,text=1,stride=32,window=2048"``.
+    Needs the compact draft cache (``--speculative-draft-window-size``) and
+    ``page_size == 1``. Instead of the most recent ``window`` target tokens
+    only, every draft step attends to the union of
+
+      sink    the first ``sink`` prompt positions (attention sinks);
+      text    every non-visual position, prompt text and generated tokens,
+              when ``text=1``;
+      stride  one of every ``stride`` positions inside each image/video span,
+              a low-resolution overview of every frame (``0`` = none);
+      window  the most recent ``window`` positions (defaults to the CLI window).
+
+    Visual spans come from the request's multimodal item offsets, so nothing
+    here is tokenizer specific. The K/V read are the very cache entries the
+    full-context draft would read; only which slots are visible changes, so
+    RoPE positions stay absolute, exactly as the draft was trained.
+    """
+
+    ENV_VAR = "SGLANG_DFLASH_DRAFT_SPARSE"
+
+    def __init__(self, *, sink: int, text: bool, stride: int, window: int):
+        self.sink = int(sink)
+        self.text = bool(text)
+        self.stride = int(stride)
+        self.window = int(window)
+
+    def __repr__(self) -> str:
+        return (
+            f"sink={self.sink},text={int(self.text)},stride={self.stride},"
+            f"window={self.window}"
+        )
+
+    @classmethod
+    def maybe_from_env(
+        cls, *, window: Optional[int], page_size: int
+    ) -> Optional["DFlashDraftSparseContext"]:
+        raw = os.environ.get(cls.ENV_VAR, "").strip()
+        if not raw:
+            return None
+        opts = {"sink": 0, "text": 1, "stride": 0, "window": None}
+        for part in raw.split(","):
+            part = part.strip()
+            if not part:
+                continue
+            key, sep, value = part.partition("=")
+            key = key.strip()
+            if not sep or key not in opts:
+                raise ValueError(
+                    f"{cls.ENV_VAR}: unknown option {part!r}; expected "
+                    "sink=<n>,text=<0|1>,stride=<n>,window=<n>"
+                )
+            opts[key] = int(value.strip())
+        if window is None:
+            raise ValueError(
+                f"{cls.ENV_VAR} needs --speculative-draft-window-size so the "
+                "draft keeps its own compact req->token table"
+            )
+        if opts["window"] is None:
+            opts["window"] = int(window)
+        if int(page_size) != 1:
+            raise ValueError(
+                f"{cls.ENV_VAR} requires page_size == 1 (arbitrary cache slots "
+                f"are gathered per position), got {page_size}"
+            )
+        for key in ("sink", "stride", "window"):
+            if opts[key] < 0:
+                raise ValueError(f"{cls.ENV_VAR}: {key} must be >= 0")
+        return cls(
+            sink=opts["sink"],
+            text=bool(opts["text"]),
+            stride=opts["stride"],
+            window=opts["window"],
+        )
+
+    def prompt_keep_mask(
+        self, prompt_len: int, spans: list, device
+    ) -> torch.Tensor:
+        """Which prompt positions stay visible, before the recent window."""
+        keep = torch.full((prompt_len,), self.text, dtype=torch.bool, device=device)
+        for start, end in spans:
+            start = max(int(start), 0)
+            end = min(int(end), prompt_len - 1)
+            if end < start:
+                continue
+            keep[start : end + 1] = False
+            if self.stride > 0:
+                keep[start + self.stride // 2 : end + 1 : self.stride] = True
+        if self.sink > 0:
+            keep[: min(self.sink, prompt_len)] = True
+        return keep
+
