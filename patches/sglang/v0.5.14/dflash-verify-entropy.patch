+class DFlashVerifyEntropyRecorder:
+    """Record the target's per-position entropy at DFlash verify time.
+
+    The entropy at a committed position is by construction the same one plain
+    autoregressive decoding would produce for that prefix — speculative decoding
+    is distribution-preserving. What only exists here is the alignment: which
+    position the draft got wrong, and how uncertain the target was exactly
+    there. Positions past the first rejection are conditioned on draft tokens
+    the target rejected, so they are recorded under ``discarded`` and must not
+    be mixed into a "what does the model's output distribution look like" study.
+
+    Off unless ``SGLANG_DFLASH_ENTROPY_DUMP`` names a file. Each verify step
+    appends one JSON object per request; the file is opened per process (pid in
+    the name) so tensor-parallel ranks never interleave writes.
+    """
+
+    ENV_VAR = "SGLANG_DFLASH_ENTROPY_DUMP"
+
+    def __init__(self, path: str):
+        base, ext = os.path.splitext(path)
+        self.path = f"{base}.pid{os.getpid()}{ext or '.jsonl'}"
+        self._handle = None
+        self._step = 0
+        logger.info("DFLASH verify-entropy recording to %s", self.path)
+
+    @classmethod
+    def maybe_create(cls) -> Optional["DFlashVerifyEntropyRecorder"]:
+        path = os.environ.get(cls.ENV_VAR, "").strip()
+        return cls(path) if path else None
+
+    @staticmethod
+    def compute(next_token_logits: torch.Tensor) -> torch.Tensor:
+        """Exact entropy in nats of every row of ``[n, vocab]`` logits.
+
+        Uses logsumexp rather than a materialized log_softmax so the peak extra
+        memory is one probability tensor instead of two, which matters because
+        the verify logits are ``[bs * block_size, vocab]``.
+        """
+        logits = next_token_logits.float()
+        log_z = torch.logsumexp(logits, dim=-1)
+        probs = torch.softmax(logits, dim=-1)
+        # H = log Z - E_p[logit]
+        return log_z - (probs * logits).sum(dim=-1)
+
+    def record(
+        self,
+        *,
+        reqs,
+        entropy,
+        accept_len,
+        block_size: int,
+        draft_tokens=None,
+        target_top1=None,
+    ) -> None:
+        """Append one record per request for this verify step."""
+        try:
+            if self._handle is None:
+                self._handle = open(self.path, "a", buffering=1)
+            entropy = entropy.view(-1, block_size).tolist()
+            accepted = accept_len.tolist()
+            drafted = draft_tokens.tolist() if draft_tokens is not None else None
+            predicted = target_top1.tolist() if target_top1 is not None else None
+            for i, req in enumerate(reqs):
+                row = {
+                    "rid": getattr(req, "rid", None),
+                    "step": self._step,
+                    "block_size": block_size,
+                    # tokens the target confirmed; position accept_len is the one
+                    # it rejected (or the block ran out), and everything after it
+                    # is conditioned on a prefix the target threw away
+                    "accept_len": int(accepted[i]),
+                    "entropy": [round(v, 5) for v in entropy[i]],
+                }
+                if drafted is not None:
+                    row["draft_tokens"] = drafted[i]
+                if predicted is not None:
+                    row["target_top1"] = predicted[i]
+                self._handle.write(json.dumps(row) + "\n")
+            self._step += 1
+        except Exception as error:  # never let diagnostics break serving
+            logger.warning("DFLASH verify-entropy recording disabled: %s", error)
+            self._handle = None
+            self.record = lambda **_kwargs: None
+
+
 _FusedKVMaterializeHelper = None
 
 
