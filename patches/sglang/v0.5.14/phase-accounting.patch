+    def phase_mark_launch(self):
+        """Start the phase clock on the first batch after an idle stretch."""
+        if self.phase_last_tic is None:
+            self.phase_last_tic = time.perf_counter()
+
+    def phase_reset_clock(self):
+        """The scheduler is idle: the next interval must not include the wait."""
+        self.phase_last_tic = None
+
+    def phase_account_step(self, batch: ScheduleBatch):
+        """Attribute the time since the previous step to this batch's phase.
+
+        Called from Scheduler.process_batch_result. Under the overlap loop the
+        GPU runs batch k while the CPU processes batch k-1, so the interval
+        between two consecutive calls is what one step costs end to end
+        (target, draft, sampling and scheduler overhead alike), and the batch
+        being processed is the one that just held the GPU. Spec-decoding
+        batches are DECODE at this level; TARGET_VERIFY is the model-side name.
+        """
+        now = time.perf_counter()
+        if self.phase_last_tic is None:
+            self.phase_last_tic = now
+            return
+        elapsed = now - self.phase_last_tic
+        self.phase_last_tic = now
+        mode = batch.forward_mode
+        if mode.is_decode() or mode.is_target_verify():
+            bs = batch.batch_size()
+            self.phase_time["decode"] += elapsed
+            self.phase_steps["decode"] += 1
+            self.phase_decode_bs_sum += bs
+            self.phase_decode_time_by_bs[bs] += elapsed
+            self.phase_decode_steps_by_bs[bs] += 1
+        elif mode.is_extend():
+            self.phase_time["extend"] += elapsed
+            self.phase_steps["extend"] += 1
+        else:
+            self.phase_time["other"] += elapsed
+            self.phase_steps["other"] += 1
+
+    def phase_account_decode_tokens(self, bs: int, decode_tokens: int):
+        """Tokens a decode step produced: one per request plus accepted drafts."""
+        self.phase_decode_tokens += decode_tokens
+        self.phase_decode_tokens_by_bs[bs] += decode_tokens
+
+    def phase_accounting(self) -> dict:
+        """Lifetime counters; a client takes differences around its run."""
+        return {
